# Stellar network — mainnet
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# Endpoints in failover order. On mainnet, public fallbacks are used when
# these are unset; put a paid provider first once contracted. A single
# STELLAR_RPC_URL / STELLAR_HORIZON_URL still works and goes first.
STELLAR_RPC_URLS=https://soroban-rpc.mainnet.stellar.gateway.fm,https://mainnet.sorobanrpc.com,https://rpc.lightsail.network
STELLAR_HORIZON_URLS=https://horizon.stellar.org,https://horizon.stellar.lobstr.co

# Contract IDs. STAKING_CONTRACT_ID is the vault; the name is kept so existing
# deployment config keeps working.
SXLM_TOKEN_CONTRACT_ID=CCGFHMW3NZD5Z7ATHYHZSEG6ABCJADUHP5HIAWFPR37CP4VGNEDQO7FJ
STAKING_CONTRACT_ID=CDYXKWVDGEVA6OSIGN7GRAPPRN6AKID35OJL5ZZQIBCMECZ35KGL45PS
LENDING_CONTRACT_ID=CAOWXZ6BWA2ZYY7GHD75OFKADKUJS4WCKPDYGGXULQWFJRB55TXAQNJG
LP_POOL_CONTRACT_ID=CAW2DRMOI3CCJWKVMEUWYJUEQHXB4S4DR72HNL2DWQCMQQUH3LFFVLHV
GOVERNANCE_CONTRACT_ID=CB7LV3FBQ7US26GVC7SM7RMX22IEEHAEUL7V3TDDWM32DHA5TDFDDEP4

# Set true only where this instance should drive mainnet: the keeper (TTL
# bumps, interest settlement, LP fee collection) and the alert monitor.
RUN_AUTOMATION=false

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://sxlm:sxlm_password@localhost:5432/sxlm_protocol

# Redis — optional, the event bus is skipped when unset
REDIS_URL=

# Contract admin address (a multisig account). No admin secret is ever
# configured here: admin actions are signed offline by the signers.
ADMIN_PUBLIC_KEY=

# Keeper keypair: signs permissionless upkeep only. Must be a different
# account from the admin and must not be one of its signers. Never commit real keys.
KEEPER_SECRET_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Alert destinations. At least one is needed for alerts to reach anyone.
SLACK_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
GOVERNANCE_WEBHOOK_URL=

# Alert thresholds (defaults shown). See docs/OPERATIONS.md, Monitoring.
# MONITOR_INTERVAL_MINUTES=5
# ALERT_REMINDER_HOURS=24
# ALERT_TTL_MIN_DAYS=7
# ALERT_KEEPER_SILENCE_HOURS=12
# ALERT_KEEPER_MIN_XLM=2
# ALERT_UTILISATION_BPS=8500
# ALERT_WITHDRAWAL_STALE_DAYS=30
# Keeper address to watch when this instance does not hold KEEPER_SECRET_KEY.
# KEEPER_PUBLIC_KEY=

# Governance voting period of the deployed contract, in ledgers (7 days).
# GOVERNANCE_VOTING_PERIOD_LEDGERS=120960
