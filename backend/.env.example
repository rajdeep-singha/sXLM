# Stellar network — mainnet
STELLAR_RPC_URL=https://soroban-rpc.mainnet.stellar.gateway.fm
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_HORIZON_URL=https://horizon.stellar.org

# Contract IDs. STAKING_CONTRACT_ID is the vault; the name is kept so existing
# deployment config keeps working.
SXLM_TOKEN_CONTRACT_ID=CCGFHMW3NZD5Z7ATHYHZSEG6ABCJADUHP5HIAWFPR37CP4VGNEDQO7FJ
STAKING_CONTRACT_ID=CDYXKWVDGEVA6OSIGN7GRAPPRN6AKID35OJL5ZZQIBCMECZ35KGL45PS
LENDING_CONTRACT_ID=CAOWXZ6BWA2ZYY7GHD75OFKADKUJS4WCKPDYGGXULQWFJRB55TXAQNJG
LP_POOL_CONTRACT_ID=CAW2DRMOI3CCJWKVMEUWYJUEQHXB4S4DR72HNL2DWQCMQQUH3LFFVLHV
GOVERNANCE_CONTRACT_ID=CB7LV3FBQ7US26GVC7SM7RMX22IEEHAEUL7V3TDDWM32DHA5TDFDDEP4

# Set true only where this instance should drive mainnet: TTL bumps,
# harvests, and automatic pause on a solvency shortfall.
RUN_AUTOMATION=true

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database
DATABASE_URL=postgresql://sxlm:sxlm_password@localhost:5432/sxlm_protocol

# Redis — optional, the event bus is skipped when unset
REDIS_URL=

# Admin keypair. Never commit real keys.
ADMIN_SECRET_KEY=
ADMIN_PUBLIC_KEY=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Optional webhooks. risk-engine posts to the governance URL on a solvency shortfall.
GOVERNANCE_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
